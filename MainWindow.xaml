<Window x:Class="EasyMusicScore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Easy Music Score" Width="1180" Height="780"
        MinWidth="900" MinHeight="620" WindowStyle="None"
        Background="#F3F5F9" ResizeMode="CanResize"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#5B6678"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#3769D6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Background="#F3F5F9" CornerRadius="12" BorderBrush="#DCE2EB" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0" Background="#FFFFFF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Border Width="28" Height="28" CornerRadius="7" Background="#EAF0FF" Margin="0,0,10,0">
                        <TextBlock Text="♫" Foreground="#3769D6" FontSize="19" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Easy Music Score" FontSize="17" FontWeight="SemiBold"
                               Foreground="#202938" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource WindowButton}" Content="—" Click="Minimize_Click"/>
                    <Button Style="{StaticResource WindowButton}" Content="□" Click="Maximize_Click"/>
                    <Button Style="{StaticResource WindowButton}" Content="✕" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Input toolbar -->
            <Grid Grid.Row="1" Margin="28,24,28,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="52" Background="White" BorderBrush="#D9E0EA"
                        BorderThickness="1" CornerRadius="9" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="54"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SourceTextBox" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" Padding="16,0,10,0"
                                 FontSize="15" Foreground="#202938"
                                 Text=" " GotFocus="SourceTextBox_GotFocus"
                                 LostFocus="SourceTextBox_LostFocus"
                                 KeyDown="SourceTextBox_KeyDown"/>
                        <Button Grid.Column="1" Content="▣" FontSize="22" Foreground="#65748B"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                ToolTip="음악 파일 선택" Click="Browse_Click"/>
                    </Grid>
                </Border>
                <Button Grid.Column="1" Style="{StaticResource ActionButton}" Margin="12,0,0,0"
                        Content="확인" Click="Confirm_Click"/>
                <Button Grid.Column="2" Width="52" Height="44" Margin="10,0,0,0"
                        Background="White" BorderBrush="#D9E0EA" BorderThickness="1"
                        Foreground="#3769D6" FontSize="21" Content="▤"
                        ToolTip="악보 인쇄" Cursor="Hand" Click="Print_Click"/>
            </Grid>

            <!-- Main score surface -->
            <Border Grid.Row="2" Margin="28,0,28,18" Background="White" CornerRadius="12"
                    BorderBrush="#E1E6EE" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="32,28,32,22">
                        <TextBlock x:Name="SongTitleText" Text="" FontSize="27" FontWeight="Bold"
                                   Foreground="#202938" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SongCreditsText" Text="" FontSize="13"
                                   Foreground="#778397" HorizontalAlignment="Center" Margin="0,9,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="34,4,34,12">
                        <StackPanel x:Name="EmptyScorePanel" VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <Border Width="76" Height="76" CornerRadius="38" Background="#F1F4FA"
                                    HorizontalAlignment="Center" Margin="0,0,0,18">
                                <TextBlock Text="♫" FontSize="39" Foreground="#8A9AB4"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="음악을 불러오면 악보가 여기에 표시됩니다."
                                       FontSize="16" Foreground="#8792A4"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="Ryoo Jaesang &amp; 최피디"
                               HorizontalAlignment="Center" Margin="0,0,0,24"
                               FontSize="13" Foreground="#778397"/>
                </Grid>
            </Border>

            <TextBlock Grid.Row="3" x:Name="StatusText" Text="준비됨"
                       Foreground="#8994A5" FontSize="11" VerticalAlignment="Center"
                       Margin="30,0,0,0"/>
        </Grid>
    </Border>
</Window>
