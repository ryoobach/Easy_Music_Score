<Window x:Class="EasyMusicScore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Easy Music Score" Icon="/Assets/EasyMusicScore.png" Width="1180" Height="780"
        MinWidth="900" MinHeight="620" WindowStyle="None"
        Background="#F3F5F9" ResizeMode="CanResize"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="44"/><Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#5B6678"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="44"/><Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="18,0"/><Setter Property="Background" Value="#3769D6"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Border Background="#F3F5F9" CornerRadius="12" BorderBrush="#DCE2EB" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#FFFFFF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Image Source="/Assets/EasyMusicScore.png" Width="28" Height="28" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Text="Easy Music Score" FontSize="17" FontWeight="SemiBold" Foreground="#202938" VerticalAlignment="Center"/>
                    <TextBlock Text="v1.22" FontSize="11" Foreground="#8994A5" VerticalAlignment="Center" Margin="9,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource WindowButton}" Content="—" Click="Minimize_Click"/>
                    <Button Style="{StaticResource WindowButton}" Content="□" Click="Maximize_Click"/>
                    <Button Style="{StaticResource WindowButton}" Content="✕" Click="Close_Click"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="28,24,28,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="52" Background="White" BorderBrush="#D9E0EA" BorderThickness="1" CornerRadius="9" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="SourceComboBox" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                                  BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="12,0,8,0"
                                  FontSize="15" Foreground="#202938" GotFocus="SourceComboBox_GotFocus" LostFocus="SourceComboBox_LostFocus"
                                  KeyDown="SourceComboBox_KeyDown" SelectionChanged="SourceComboBox_SelectionChanged"
                                  ToolTip="곡 제목·가수 이름을 입력하거나 MP3 파일을 선택하세요"/>
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="MP3 파일 찾아보기" Click="Browse_Click">
                            <Viewbox Width="25" Height="25"><Canvas Width="32" Height="32">
                                <Path Data="M3,8 L3,6 C3,4.9 3.9,4 5,4 L12,4 L15,7 L27,7 C28.1,7 29,7.9 29,9 L29,24 C29,25.1 28.1,26 27,26 L5,26 C3.9,26 3,25.1 3,24 Z" Stroke="#526783" StrokeThickness="1.9" Fill="#EEF3FA" StrokeLineJoin="Round"/>
                                <Path Data="M3.5,12 L28.5,12" Stroke="#526783" StrokeThickness="1.7"/>
                                <Path Data="M20,18 L24,22 M19,17 A4,4 0 1 1 11,17 A4,4 0 1 1 19,17" Stroke="#3769D6" StrokeThickness="1.8" Fill="Transparent"/>
                            </Canvas></Viewbox>
                        </Button>
                    </Grid>
                </Border>
                <Button Grid.Column="1" Style="{StaticResource ActionButton}" Margin="12,0,0,0" Content="확인" Click="Confirm_Click"/>
                <Button Grid.Column="2" Width="52" Height="44" Margin="10,0,0,0" Background="White" BorderBrush="#D9E0EA" BorderThickness="1" ToolTip="악보 인쇄" Cursor="Hand" Click="Print_Click">
                    <Viewbox Width="25" Height="25"><Canvas Width="32" Height="32">
                        <Path Data="M9,11 L9,4 L23,4 L23,11 M9,23 L5,23 C3.9,23 3,22.1 3,21 L3,14 C3,12.9 3.9,12 5,12 L27,12 C28.1 12 29,12.9 29,14 L29,21 C29,22.1 28.1,23 27,23 L23,23" Stroke="#3769D6" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round"/>
                        <Path Data="M9,19 L23,19 L23,28 L9,28 Z" Stroke="#3769D6" StrokeThickness="2" Fill="#EEF3FF"/>
                        <Path Data="M24,15 L26,15" Stroke="#3769D6" StrokeThickness="2"/>
                    </Canvas></Viewbox>
                </Button>
            </Grid>
            <Border x:Name="ScoreSurface" Grid.Row="2" Margin="28,0,28,18" Background="White" CornerRadius="12" BorderBrush="#E1E6EE" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="32,20,32,14">
                        <TextBlock x:Name="SongTitleText" Text="" FontSize="25" FontWeight="Bold" Foreground="#202938" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SongCreditsText" Text="" FontSize="12" Foreground="#778397" HorizontalAlignment="Center" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel x:Name="ArtistChoicePanel" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="420" Panel.ZIndex="5" Background="White">
                        <TextBlock Text="같은 제목의 곡이 여러 개 검색되었습니다." FontSize="17" FontWeight="SemiBold" Foreground="#202938" Margin="0,0,0,12"/>
                        <TextBlock Text="원하는 아티스트를 선택해 주세요." FontSize="13" Foreground="#778397" Margin="0,0,0,10"/>
                        <ListBox x:Name="ArtistChoiceList" Height="220" FontSize="15" Padding="6" DisplayMemberPath="Artist"/>
                        <Button Content="선택한 아티스트의 악보 보기" Height="42" Margin="0,12,0,0" Background="#3769D6" Foreground="White" BorderThickness="0" Click="ArtistChoiceConfirm_Click"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <wv2:WebView2 x:Name="SearchWebView" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <StackPanel x:Name="EmptyScorePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30,24">
                            <TextBlock x:Name="NoticeTitleText" Text="음원을 선택하거나 검색어를 입력해 주세요." FontSize="24" FontWeight="Bold" Foreground="#8792A4" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock x:Name="NoticeReasonText" Text="" FontSize="14" Foreground="#778397" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24"/>
                            <TextBlock Text="Easy Music Score 사용 방법" FontSize="16" FontWeight="SemiBold" Foreground="#35445B" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="1. MP3 파일을 선택하거나 곡 제목·가수 이름을 입력합니다.&#10;2. 확인 버튼을 누릅니다.&#10;3. 프로그램이 검색 결과에서 곡 제목과 일치하는 악보를 분석합니다.&#10;4. 가장 적합한 악보 이미지 한 장을 골라 표시합니다.&#10;5. 찾지 못하면 “악보를 찾을 수 없습니다.”라고 안내합니다."
                                       FontSize="14" LineHeight="27" Foreground="#68768B" TextAlignment="Left" HorizontalAlignment="Center"/>
                            <TextBlock Text="※ 검색 결과 목록을 그대로 보여주지 않고, 제목에 맞는 악보 후보 한 장을 골라 표시합니다. 오선악보 재구성과 인쇄 기능은 후속 단계에서 연결합니다." FontSize="12" Foreground="#8A96A8" Margin="0,18,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,18">
                        <Image Source="/Assets/EasyMusicScore.png" Width="18" Height="18" Stretch="Uniform" Margin="0,0,7,0"/>
                        <TextBlock Text="Ryoo Jaesang &amp; 최피디" FontSize="13" Foreground="#778397" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Grid.Row="3" x:Name="StatusText" Text="준비됨" Foreground="#8994A5" FontSize="11" VerticalAlignment="Center" Margin="30,0,0,0"/>
        </Grid>
    </Border>
</Window>