<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EasyMusicScore</AssemblyName>
    <RootNamespace>EasyMusicScore</RootNamespace>
    <Version>1.14</Version>
    <ApplicationIcon>Assets\EasyMusicScore.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\EasyMusicScore.ico" />
    <Resource Include="Assets\EasyMusicScore.png" />
  </ItemGroup>
</Project>