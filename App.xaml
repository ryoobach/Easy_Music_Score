<Application x:Class="EasyMusicScore.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Color x:Key="Ink">#202938</Color>
        <Color x:Key="Muted">#778397</Color>
        <Color x:Key="Accent">#3769D6</Color>
        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}"/>
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    </Application.Resources>
</Application>
